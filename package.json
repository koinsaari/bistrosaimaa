  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "vercel-build": "([ \"$VERCEL_ENV\" != preview ] || npm run db:migrate) && next build",
    "start": "next start",
    "lint": "eslint src",
